# =============================================================================
# Variables d'environnement pour l'environnement Production
# RAG Ultra Performant Multimodal API
# =============================================================================


APP_NAME=RAG Ultra Performant Multimodal
APP_VERSION=2005.0.1
DEBUG=false
LOG_LEVEL=INFO
ENVIRONMENT=production



# ================================
# CONFIGURATION BOT TELEGRAM
# ================================

# Token du bot Telegram (obligatoire)
# Obtenez-le via @BotFather sur Telegram
TELEGRAM_TOKEN=

# URL de l'API CSS (par défaut localhost)
CSS_API_URL=http://localhost:8000


IPINFO_TOKEN=0dd64d32d1e366


# ================================
# DÉMARRAGE AUTOMATIQUE
# ================================

# Activer le démarrage automatique du bot avec l'API
# true = le bot démarre automatiquement avec uvicorn
# false = démarrage manuel séparé
AUTO_START_TELEGRAM_BOT=true

# ================================
# CONFIGURATION DEBUG
# ================================

# Mode debug pour les logs détaillés
DEBUG_MODE=false

# ================================
# CONFIGURATION API CSS
# ================================

# Système de Q&A prédéfinies (optimisation des réponses)
# true = Active les réponses prédéfinies pour les questions courantes (recommandé)
# false = Désactive le système, toutes les questions passent par le RAG
ENABLE_PREDEFINED_QA=true
ENABLE_QUERY_ENHANCEMENT=false

# Clés API pour les fournisseurs LLM (optionnel)
MISTRAL_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=


# Serveur
HOST=0.0.0.0
PORT=8000
WORKERS=4
RELOAD=false

# Base de données et services
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_MAX_CONNECTIONS=50

CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_AUTH_TOKEN=

# ClickHouse (pour ChromaDB en production)
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=

# Sécurité
SECRET_KEY=
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRATION=3600

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:80","http://localhost:8080", "http://192.168.125.150:8080","http://192.168.125.150:80"]
CORS_METHODS=["GET", "POST", "PUT", "DELETE", "OPTIONS"]
CORS_HEADERS=["Authorization", "Content-Type", "X-Requested-With"]

# Modèles IA
EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2
LLM_MODEL=microsoft/DialoGPT-large
MODEL_CACHE_DIR=/app/.cache/models

# Configuration avancée
MAX_UPLOAD_SIZE=50MB
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_TOKENS=4000
TEMPERATURE=0.7

# Monitoring et logs
ENABLE_METRICS=true
METRICS_PORT=9090
LOG_FORMAT=json
LOG_ROTATION=daily

# Cache et performance
CACHE_TTL=3600
MAX_CONCURRENT_REQUESTS=100
REQUEST_TIMEOUT=300

# Multimodal
ENABLE_MULTIMODAL=true
MAX_IMAGE_SIZE=10MB
SUPPORTED_IMAGE_FORMATS=["jpg", "jpeg", "png", "gif", "bmp", "webp"]

# Base de données vectorielle
VECTOR_DB_TYPE=chroma
SIMILARITY_THRESHOLD=0.7
MAX_RESULTS=10

# Sécurité avancée
RATE_LIMIT_PER_MINUTE=60
ENABLE_CORS=true
ENABLE_HTTPS_REDIRECT=false

# Backup et maintenance
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 2 * * *"
CLEANUP_OLD_LOGS=true
LOG_RETENTION_DAYS=30



# ================================
# INSTRUCTIONS D'UTILISATION
# ================================

# 1. Copiez ce fichier : cp .env.telegram.example .env
# 2. Remplissez au minimum TELEGRAM_TOKEN
# 3. Démarrez avec : python -m uvicorn app.main:app --host 0.0.0.0 --port 8000
# 4. Ou utilisez : python start_with_telegram.py
# 5. Ou avec Docker : docker-compose -f docker-compose.telegram.yml up